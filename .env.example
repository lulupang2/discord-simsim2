# Required
DISCORD_TOKEN=replace-with-discord-bot-token
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional
