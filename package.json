{
  "name": "discord-llm-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord conversational bot backed by an OpenAI-compatible chat-completions API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "export-dataset": "node dist/scripts/export-dataset.js",
    "ingest-channel": "node dist/scripts/ingest-channel.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
